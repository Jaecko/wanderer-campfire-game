# BigWigs packager: the zip is the addon folder "WandererCampfireGame", the changelog of the
# version is CHANGELOG.md (written at each release from the full changelog).
package-as: WandererCampfireGame

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - README.md

# Shown on CurseForge: Wanderer Campfire Game needs Wanderer.
required-dependencies:
  - wanderer
